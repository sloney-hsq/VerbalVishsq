# This application reads process environment, not .env automatically.
DASHSCOPE_API_KEY=your-own-key
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_VOICE=Ethan
# Relative to working directory; omit for bundled education configuration.
VERBALVIS_CONFIG=configs/education.json
